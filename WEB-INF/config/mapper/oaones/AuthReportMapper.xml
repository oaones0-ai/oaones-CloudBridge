<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  OAones 统一认证报表（一级菜单 /oaones/authReport/authReport.jsp）

  一张“跨平台只读看板”，回答：各个租户下有多少人、绑定了多少、没绑定多少，
  以及今日新增绑定 / 今日统一认证登录，和这两个指标按日 / 按月的走势。

  只读：本 Mapper 全部是 select，没有任何写库语句。表名统一走 OaonesParam 注入的
  ${...} 占位（cfgTable / userTmpTable / userBindTable / opLogTable），不写死物理表名。

  口径：
    · 总人数   = 该租户平台成员快照的有效成员数（userTmpTable：corpid + type 一致、status = 0）；
    · 已绑定   = userBindTable 里该租户 bind_state = 1 的去重 OA 人员数（可按 OA 分部过滤）；
    · 未绑定   = 总人数 - 已绑定（页面计算，不小于 0）；
    · 新增绑定 = 绑定时间（bind_time，空值退回 modedatacreatedate）落在统计区间内的去重人数；
    · 登录     = 统一认证登录留痕 opLogTable 里 op_type = 'login' 的去重人数，
                 按“登录人 → 该租户的绑定关系”归属到租户（一人绑多租户时各租户各计一次）。

  区间比较统一把日期截到 10 位 yyyy-MM-dd；按日粒度取 1..10、按月粒度取 1..7。
-->
<mapper namespace="com.customization.oaones.appsyn.dao.AuthReportMapper">

    <!-- 绑定时间（字符串）：bind_time 优先，空值退回建模创建日期 -->
    <sql id="bindDateExpr">
        case when b.bind_time is not null and b.bind_time &lt;&gt; ''
             then b.bind_time else b.modedatacreatedate end
    </sql>

    <!-- 绑定期望粒度表达式：day 取 yyyy-MM-dd、month 取 yyyy-MM -->
    <sql id="bindPeriodExpr">
        <choose>
            <when test='granularity == "month"'>
                substring((<include refid="bindDateExpr"/>), 1, 7)
            </when>
            <otherwise>
                substring((<include refid="bindDateExpr"/>), 1, 10)
            </otherwise>
        </choose>
    </sql>

    <!-- 租户候选（含平台类型与企业标识；按平台 / 名称排序） -->
    <select id="listCfgs" resultType="java.util.LinkedHashMap">
        select c.id as id, c.type as platform, c.corp_name as cfgName,
               c.corp_id as corpId, c.qy as cfgEnable
        from ${cfgTable} c
        <where>
            <if test="cfgIds != null and cfgIds.size() > 0">
                and c.id in
                <foreach collection="cfgIds" item="cid" open="(" separator="," close=")">#{cid}</foreach>
            </if>
        </where>
        order by c.type, c.corp_name, c.id
    </select>

    <!-- OA 分部候选（有效分部，供多选筛选） -->
    <select id="listSubs" resultType="java.util.LinkedHashMap">
        select s.id as id, s.subcompanyname as name
        from hrmsubcompany s
        where (s.canceled is null or s.canceled = '' or s.canceled = '0')
        order by s.id
    </select>

    <!-- 各租户平台成员数（快照 status = 0 有效；含没有任何成员 / 没有快照的租户，记 0） -->
    <select id="memberCounts" resultType="java.util.LinkedHashMap">
        select c.id as cfgId, count(t.id) as memberCount
        from ${cfgTable} c
        left join ${userTmpTable} t
               on t.corpid = c.corp_id and t.type = c.type and t.status = 0
        <where>
            <if test="cfgIds != null and cfgIds.size() > 0">
                and c.id in
                <foreach collection="cfgIds" item="cid" open="(" separator="," close=")">#{cid}</foreach>
            </if>
        </where>
        group by c.id
    </select>

    <!-- 各租户已绑定人数（bind_state = 1 去重 OA 人员；可按 OA 分部过滤） -->
    <select id="boundCounts" resultType="java.util.LinkedHashMap">
        select b.cfg_id as cfgId, count(distinct b.oa_user_id) as boundCount
        from ${userBindTable} b
        left join hrmresource r on r.id = b.oa_user_id
        <where>
            and b.bind_state = 1
            <if test="cfgIds != null and cfgIds.size() > 0">
                and b.cfg_id in
                <foreach collection="cfgIds" item="cid" open="(" separator="," close=")">#{cid}</foreach>
            </if>
            <if test="subIds != null and subIds.size() > 0">
                and r.subcompanyid1 in
                <foreach collection="subIds" item="sid" open="(" separator="," close=")">#{sid}</foreach>
            </if>
        </where>
        group by b.cfg_id
    </select>

    <!-- 新增绑定走势：按 租户 + 日/月 分组，统计区间按绑定日期过滤 -->
    <select id="bindTrend" resultType="java.util.LinkedHashMap">
        select b.cfg_id as cfgId,
               (<include refid="bindPeriodExpr"/>) as period,
               count(distinct b.oa_user_id) as cnt
        from ${userBindTable} b
        left join hrmresource r on r.id = b.oa_user_id
        <where>
            and b.bind_state = 1
            and substring((<include refid="bindDateExpr"/>), 1, 10) &gt;= #{fromDate}
            and substring((<include refid="bindDateExpr"/>), 1, 10) &lt;= #{toDate}
            <if test="cfgIds != null and cfgIds.size() > 0">
                and b.cfg_id in
                <foreach collection="cfgIds" item="cid" open="(" separator="," close=")">#{cid}</foreach>
            </if>
            <if test="subIds != null and subIds.size() > 0">
                and r.subcompanyid1 in
                <foreach collection="subIds" item="sid" open="(" separator="," close=")">#{sid}</foreach>
            </if>
        </where>
        group by b.cfg_id, (<include refid="bindPeriodExpr"/>)
        order by period
    </select>

    <!-- 统一认证登录走势：op_log 的 login 事件，按 租户 + 日/月 分组（租户取登录人的绑定关系）
         绑定关系用 left join：登录人没绑任何租户时 cfgId = 0（页面显示为“未归属租户”），
         不能因为“没绑定”就把这次登录丢掉 —— 本指标统计的是“通过统一认证平台登录的人数”。 -->
    <select id="loginTrend" resultType="java.util.LinkedHashMap">
        select isnull(b.cfg_id, 0) as cfgId,
               <choose>
                   <when test='granularity == "month"'>substring(o.modedatacreatedate, 1, 7)</when>
                   <otherwise>substring(o.modedatacreatedate, 1, 10)</otherwise>
               </choose> as period,
               count(distinct o.user_id) as cnt
        from ${opLogTable} o
        left join ${userBindTable} b on b.oa_user_id = o.user_id and b.bind_state = 1
        left join hrmresource r on r.id = o.user_id
        <where>
            and o.op_type = 'login'
            and substring(o.modedatacreatedate, 1, 10) &gt;= #{fromDate}
            and substring(o.modedatacreatedate, 1, 10) &lt;= #{toDate}
            <if test="cfgIds != null and cfgIds.size() > 0">
                and b.cfg_id in
                <foreach collection="cfgIds" item="cid" open="(" separator="," close=")">#{cid}</foreach>
            </if>
            <if test="subIds != null and subIds.size() > 0">
                and r.subcompanyid1 in
                <foreach collection="subIds" item="sid" open="(" separator="," close=")">#{sid}</foreach>
            </if>
        </where>
        group by isnull(b.cfg_id, 0),
                 <choose>
                     <when test='granularity == "month"'>substring(o.modedatacreatedate, 1, 7)</when>
                     <otherwise>substring(o.modedatacreatedate, 1, 10)</otherwise>
                 </choose>
        order by period
    </select>

</mapper>
