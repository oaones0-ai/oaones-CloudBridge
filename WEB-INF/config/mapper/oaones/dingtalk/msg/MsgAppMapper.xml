<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  OAones 统一消息中心：推送用钉钉应用（只读）
  数据来自“应用绑定”表 uf_oaones_app_bind（表名取 appbind.table）+ 钉钉租户配置表
  （表名取 cfg.table），与应用绑定页共用同一行应用，消息中心不再单独维护应用表。
  yx：0 有效 / 1 停用（与 uf_oaones_app_bind.yx 同口径）。
-->
<mapper namespace="com.customization.oaones.appsyn.msg.dingtalk.dao.MsgAppMapper">

    <sql id="cols">
        b.id, b.cfg_id, b.app_name, b.agent_id, b.app_secret, b.oa_page_url, b.yx, b.remark,
        b.modedatamodifier, b.modedatamodifydatetime,
        c.corp_name as cfg_name, c.corp_id as corp_id, c.corp_secret as corp_secret, c.qy as cfg_qy
    </sql>

    <sql id="joins">
        from ${appBindTable} b
        left join ${cfgTable} c on c.id = b.cfg_id
    </sql>

    <select id="list" resultType="com.customization.oaones.appsyn.msg.dingtalk.entity.MsgApp">
        select <include refid="cols"/>
        <include refid="joins"/>
        where c.type = 1
        order by case when b.yx = 0 then 0 else 1 end, b.cfg_id, b.id
    </select>

    <select id="listEnabled" resultType="com.customization.oaones.appsyn.msg.dingtalk.entity.MsgApp">
        select <include refid="cols"/>
        <include refid="joins"/>
        where b.yx = 0 and c.type = 1
        order by b.cfg_id, b.id
    </select>

    <select id="getById" resultType="com.customization.oaones.appsyn.msg.dingtalk.entity.MsgApp">
        select <include refid="cols"/>
        <include refid="joins"/>
        where b.id = #{id} and c.type = 1
    </select>

    <select id="listEnabledByCfgId" resultType="com.customization.oaones.appsyn.msg.dingtalk.entity.MsgApp">
        select <include refid="cols"/>
        <include refid="joins"/>
        where b.yx = 0 and b.cfg_id = #{cfgId} and c.type = 1
        order by b.id
    </select>
</mapper>
